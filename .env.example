# Configuração Firebase — Recibo App
# Copie este arquivo para .env e preencha com as suas credenciais do Firebase Console

VITE_FIREBASE_API_KEY=cole_aqui_sua_apiKey
VITE_FIREBASE_AUTH_DOMAIN=cole_aqui_seu_authDomain
VITE_FIREBASE_PROJECT_ID=cole_aqui_seu_projectId
VITE_FIREBASE_STORAGE_BUCKET=cole_aqui_seu_storageBucket
VITE_FIREBASE_MESSAGING_SENDER_ID=cole_aqui_seu_messagingSenderId
VITE_FIREBASE_APP_ID=cole_aqui_seu_appId
